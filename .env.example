# Database — Supabase → Project Settings → Database → Connection string → URI
# Leave empty to run in demo mode: seeded notes held in memory, no database.
DATABASE_URL=

# AI — any OpenAI-compatible endpoint. Defaults point at Groq's free tier.
# Get a free key at https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# One passphrase in front of the journal. Empty = no login (fine locally).
APP_PASSCODE=

# Decides which day "today" is. Defaults to UTC. Example: Asia/Kolkata
APP_TIMEZONE=
